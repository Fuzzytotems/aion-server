# M5b-3 profile of the C++ game server (cpp/docs/design/m5b3-plan.md §10.1 and decision D3). The scenario gates (gs.scenario.m5b3,
# gs.scenario.m5b3_geo) pass the same keys as -D arguments: loot a corpse, kinah, keep, stack, split, move, swap and destroy items, equip and
# unequip, drink a potion, socket a godstone and see it proc, and (geo on) stand in a camp fire.
#
# It is the M5b-2 profile (m5b2.properties.example) with the drop rate changed from 0 to 1000000 and the potion, godstone and drop-announce
# keys written out. Keep the files in sync: M5b-3 adds to M5b-2, M5b-1 and M5a, it replaces nothing else.
#
# TO PLAY with a real 4.8 client (m5b3-plan.md §11): copy these lines into config/mygs.properties but set gameserver.rates.drop back to
# "1.0, 2.0" - at 1000000 every applicable drop rule fires on every kill and the cube fills after a few corpses.
#
# Not read by the servers: only config/mygs.properties is loaded.

# --- the M5a profile, unchanged ------------------------------------------------------------------------------------------------------------

# C++ only: NPCs whose AI handler is not ported yet get a dummy AI with a warning instead of failing the spawn (fail = default)
gameserver.dev.missing_ai_handlers = warn

# systems whose services are not part of M5a
gameserver.siege.enable = false
gameserver.autogroup.enable = false
gameserver.rift.enable = false
gameserver.vortex.enable = false
gameserver.worldraid.enable = false
gameserver.cp.enable = false
gameserver.limits.enable = false
# every event off, including the date-less "Beyond Aion Server Buffs" of custom_events.xml. M5b-3 relies on it: with events on,
# registerDrop runs the global rules a second time over EventService.getActiveEventDropRules() (DropRegistrationService.java:96-98), and the
# active events' rules add entries to every corpse; "*" makes collectActiveEvents return nothing (EventService.java:133-134)
gameserver.event.service.disabled_events = *

# the address the login server lists for this game server (the default 0.0.0.0 is not reachable by the client)
gameserver.network.client.connect_address = 127.0.0.1:7777

# --- the M5b-1 profile, unchanged --------------------------------------------------------------------------------------------------------

# the shout service is 6 unported bodies (P5-14) and an aggroing monster is what would reach it. false is already the default
# (AIConfig.cpp:14); it is written out so that a local mygs.properties cannot turn it on by accident (m5b-plan.md D1).
gameserver.npcshouts.enable = false

# the solo experience rates the M5b gate's exp assertion is derived against (m5b-plan.md D7/§6.3 R1); "1.0, 2.0" is the default
# (RatesConfig.java:30)
gameserver.rates.xp.solo = 1.0, 2.0

# --- the M5b-2 profile, unchanged (D5 of m5b2-plan.md) -------------------------------------------------------------------------------------

# Soul sickness ON: the retail default, written out (m5b2.properties.example says why a missing line is not enough).
gameserver.soulsickness.disable = 10

# --- what M5b-3 changes and adds -----------------------------------------------------------------------------------------------------------

# Every applicable drop rule fires (m5b3-plan.md D3, §2.4). Rates.get(killer, DROP_RATES) multiplies every global and custom rule chance
# (DropRegistrationService.java:218, DropModifiers.java:53-57) and a rule fires unless Rnd.chance() >= chance, Rnd.chance() being in [0, 100)
# (DropRegistrationService.java:189, Rnd.java:32-34). At 1000000 the smallest rule of the start maps (0.01 %) becomes 10,000 %; 10000 would
# leave it at exactly 100.0f after float rounding (tools/oracle/m5b3/drops.py warns about it). A one-value list applies to every membership
# level (Rates.java:171-172). The M5b and M5b-2 profiles set 0 instead (D4). FOR PLAY SET "1.0, 2.0" (the default, RatesConfig.java:81-82).
gameserver.rates.drop = 1000000

# Potions are consumed at full HP/MP too: the default (CustomConfig.java:243-244), written out because true makes SkillUseAction.canAct refuse
# a heal item on a fully healed character (SkillUseAction.java:75-78) and the gate's potion case depends on which one applies.
gameserver.items.ignore_potions_at_full_health = false

# Godstone procs at the template probability, evaluated at most every 750 ms: the defaults (CustomConfig.java:273-277), written out because the
# gate's proc case (Y7) counts one proc message per evaluated hit.
gameserver.rates.godstone.activation.rate = 1.0
gameserver.rates.godstone.evaluation.cooldown_millis = 750

# A looted item of this quality or higher is announced to the other players of the map and race (DropService.announceDrop,
# DropService.java:496-503). The value of config/main/drop.properties, written out because DropConfig.java:18-19 has no default.
gameserver.drop.announce_quality = MYTHIC

# Only in the scenario gates, not for play (geo data stays on with the real client; gs.scenario.m5b3_geo turns it on and adds the camp fire):
# gameserver.geodata.enable = false
# gameserver.character.reentry.time = 1
# gameserver.shutdown.delay = 2
