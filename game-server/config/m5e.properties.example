# M5e profile of the C++ game server (cpp/docs/design/m5e-plan.md §10.1, §11, decisions D1 and D9): a character levels from 1 to its class
# master's quest, hits the level-9 wall, changes class, becomes a Daeva and uses its first skills, a Cleric resurrects, a Chanter's mantra,
# an Aethertech's robot, a skill book, a Spiritmaster's spirit, a stigma.
#
# It is the M5c profile (m5c.properties.example) with what the M5d gate passes (the quest rates and the quest spawn analysis, written out; the
# M5d gate has no file of its own) and the quest experience rate of M5e pinned. The M5c keys stay (crafting and socketing without chance);
# nothing of M5e reads them. Keep the files in sync: M5e adds to M5d, M5c, M5b-3, M5b-2, M5b-1 and M5a.
#
# The scenario gate (gs.scenario.m5e) does NOT pass this whole file: it passes the M5d gate's keys as -D arguments (M5eScenarioTest.cpp's
# gateKeys: of the M5b-3 section only the drop rate 0, none of the M5c section) and turns ONE key the other way:
# gameserver.simple.secondclass.enable = true, its only way to seed a class change before the retail route is ported (D1).
#
# TO PLAY with a real 4.8 client (m5e-plan.md §11): copy these lines into config/mygs.properties, as they are. D1 is answered (2026-10-04):
# players change class through the retail ascension missions 1006 / 2008 and their ceremonies 1007 / 2009, as the game does it, so play runs
# with gameserver.simple.secondclass.enable = false (below). Those missions are ported with M5f (m5e-plan.md D13); until then a character
# stops at the level-9 wall, and a Daeva is made by SQL while offline (§11 step 4).
#
# Not read by the servers: only config/mygs.properties is loaded.

# --- the M5a profile, unchanged ------------------------------------------------------------------------------------------------------------

# C++ only: NPCs whose AI handler is not ported yet get a dummy AI with a warning instead of failing the spawn (fail = default)
gameserver.dev.missing_ai_handlers = warn

# systems whose services are not part of M5a; the siege off also fixes the prices (m5c-plan.md §2.10), which a stigma's kinah goes through
# (StigmaService.notifyEquipAction -> PricesService.getPriceForService, X18)
gameserver.siege.enable = false
gameserver.autogroup.enable = false
gameserver.rift.enable = false
gameserver.vortex.enable = false
gameserver.worldraid.enable = false
gameserver.cp.enable = false
gameserver.limits.enable = false
# every event off, including the date-less "Beyond Aion Server Buffs" of custom_events.xml
gameserver.event.service.disabled_events = *

# the address the login server lists for this game server (the default 0.0.0.0 is not reachable by the client)
gameserver.network.client.connect_address = 127.0.0.1:7777

# --- the M5b-1 profile, unchanged --------------------------------------------------------------------------------------------------------

# the shout service; false is already the default (AIConfig.cpp:14), written out (m5b-plan.md D1)
gameserver.npcshouts.enable = false

# the solo experience rates (m5b-plan.md D7); "1.0, 2.0" is the default (RatesConfig.java:30). M5e's kills level a character, and the gate's
# thresholds come from the oracle's experience table, not from a kill's exp
gameserver.rates.xp.solo = 1.0, 2.0

# --- the M5b-2 profile, unchanged (D5 of m5b2-plan.md) -------------------------------------------------------------------------------------

# Soul sickness ON: the retail default, written out. M5e's resurrection (X13) gives 1699's own 8296, which this key does not change
gameserver.soulsickness.disable = 10

# --- the M5b-3 profile, with the drop rate of the gates other than M5b-3's own (m5b3-plan.md D4) ------------------------------------------

gameserver.rates.drop = 0
gameserver.items.ignore_potions_at_full_health = false
gameserver.rates.godstone.activation.rate = 1.0
gameserver.rates.godstone.evaluation.cooldown_millis = 750
gameserver.drop.announce_quality = MYTHIC

# --- the M5c profile, unchanged (m5c-plan.md D6) -------------------------------------------------------------------------------------------

gameserver.craft.fail.chance = 0
gameserver.rates.crafting.crit_chances = 0, 0
gameserver.rates.manastone_chances = 200, 200

# --- what the M5d gate passes (M5dScenarioTest.cpp's gate keys; m5d-plan.md D7, §10.1) ------------------------------------------------------

# the quest kinah rate at its default, written out: membership 0 -> 1.0 (RatesConfig.java:78)
gameserver.rates.kinah.quest = 1.0, 2.0
# the quest spawn analysis off at startup (GSConfig.java:80, default true): it changes no quest, it only costs startup time
gameserver.analysis.quest_handlers = false

# --- what M5e adds (m5e-plan.md D1, D9) ----------------------------------------------------------------------------------------------------

# D1, answered 2026-10-04: the retail route. OFF for play (the Java default, CustomConfig.java:68, config/main/custom.properties:32): the
# class change is the ascension mission 1006 / 2008 (Karamatis B / Ataxiar B), which registers only with the key off
# (_1006Ascension.java:48-50). The scenario gate passes true instead, only to seed a class change: then a starting class of level 9 or more
# gets SM_DIALOG_WINDOW(0, its selection page, 1006 / 2008) at every enter world (PlayerEnterWorldService.java:320-321,
# ClassChangeService.showClassChangeDialog), and the client's CM_DIALOG_SELECT(0, action, ..., 1006 / 2008) changes its class
# (CM_DIALOG_SELECT.java:105-106, ClassChangeService.changeClassToSelection).
gameserver.simple.secondclass.enable = false

# D9: the quest experience rate pinned at its default (RatesConfig.java:36), applied without a cap by Rates.XP_QUEST (Rates.java:29-33): the
# class master's 275 exp of quest 1205 (X1) is exact for a membership-0 account
gameserver.rates.xp.quest = 1.0, 2.0

# Only in the scenario gate, not for play (geo data stays on with the real client; the gate also passes
# gameserver.simple.secondclass.enable = true, above):
# gameserver.geodata.enable = false
# gameserver.character.reentry.time = 1
# gameserver.shutdown.delay = 2
