# M5b-1 profile of the C++ game server (cpp/docs/design/m5b-plan.md, decision D1). Copy these lines into config/mygs.properties to play with a
# real 4.8 client at milestone M5b-1 (melee combat: pull a Poeta or Ishalgen monster, hit it, be hit back, die, revive, watch it respawn). The
# scenario gate (gs.scenario.m5b) passes the same keys as -D arguments.
#
# It is the M5a profile (m5a.properties.example) plus the keys the fight path needs. Keep both files in sync: M5b-1 adds to M5a, it replaces
# nothing.
#
# Not read by the servers: only config/mygs.properties is loaded.

# --- the M5a profile, unchanged ------------------------------------------------------------------------------------------------------------

# C++ only: NPCs whose AI handler is not ported yet get a dummy AI with a warning instead of failing the spawn (fail = default). M5b-1 registers
# three of the 433 AI names (general, aggressive, noaction - m5b-plan.md A-06), so this stays on for the other 430.
gameserver.dev.missing_ai_handlers = warn

# systems whose services are not part of M5a
gameserver.siege.enable = false
gameserver.autogroup.enable = false
gameserver.rift.enable = false
gameserver.vortex.enable = false
gameserver.worldraid.enable = false
gameserver.cp.enable = false
gameserver.limits.enable = false
# every event off, including the date-less "Beyond Aion Server Buffs" of custom_events.xml
gameserver.event.service.disabled_events = *

# the address the login server lists for this game server (the default 0.0.0.0 is not reachable by the client)
gameserver.network.client.connect_address = 127.0.0.1:7777

# --- what M5b-1 adds -----------------------------------------------------------------------------------------------------------------------

# Soul sickness ON, the retail default, stated explicitly (cpp/docs/design/m5b2-plan.md D5 and §10.6).
#
# gameserver.soulsickness.disable is the minimum membership level that is EXEMPT from soul sickness (MembershipConfig.java:37-38,
# @Property defaultValue = "10"), and Player.hasPermission(perm) is `playerAccount.getMembership() >= perm` (Player.java:1275-1277).
# A normal account has membership 0, so the default of 10 exempts nobody and 0 exempts everybody.
#
# M5b-1 shipped this line as 0: SkillEngine::getSkill was AION_UNPORTED, and PlayerReviveService.bindRevive -> revive(..., setSoulSickness =
# true, ...) -> PlayerController.updateSoulSickness -> SkillEngine.getInstance().getSkill(player, 8291, deathCount, player).useSkill()
# (PlayerReviveService.java:104-108, PlayerController.java:712-733) would have thrown and left the character a corpse. M5b-2 ported the skill
# engine, so a bind-point revive now casts Soul Sickness 8291 as on retail. The value is written out rather than left to the default because a
# config/mygs.properties copied from the M5b-1 version of this file still carries the 0, and that one line hid the soul sickness from the
# first gs.scenario.m5b2 run. The scenario gates pass the same 10 as a -D argument.
gameserver.soulsickness.disable = 10

# the shout service is 6 unported bodies (P5-14) and an aggroing monster is what would reach it. false is already the default
# (AIConfig.cpp:14); M5b-1 writes it out so that a local mygs.properties cannot turn it on by accident (m5b-plan.md D1).
gameserver.npcshouts.enable = false

# the solo experience rates the gate's exp assertion is derived against (m5b-plan.md D7/§6.3 R1). "1.0, 2.0" is the default
# (RatesConfig.java:30); it is written out because the assertion is an exact integer and a changed rate silently moves it.
gameserver.rates.xp.solo = 1.0, 2.0

# --- what M5b-3 changes in this profile (cpp/docs/design/m5b3-plan.md D4) ----------------------------------------------------------------

# No drops. Rates.get(killer, DROP_RATES) multiplies the chance of every global and custom drop rule (DropRegistrationService.java:218,
# DropModifiers.java:53-57, DropGroup.java:64), so at 0 none ever fires, while registerDrop still runs completely (the DropNpc,
# SM_LOOT_STATUS(LOOT_ENABLE), the free-for-all task). Quest drops are not scaled (QuestService.java:673) but need a started quest (M5d). A
# corpse with an empty drop set decays after 2 s (RespawnService IMMEDIATE_DECAY) instead of the 300 s of a corpse with loot, which is what
# this milestone's gate asserts about corpses (m5b3-plan.md finding 1). The retail default is "1.0, 2.0" (RatesConfig.java:81-82); for loot,
# use m5b3.properties.example.
# The gate profile (M5bScenarioTest.cpp) carries the same key since M5b-3 stage 1 (G-05, landed with L-01's registerDrop, m5b3-plan.md D4):
# its R3 row asserts one SM_LOOT_STATUS(LOOT_ENABLE) per kill with lootEffectId 0, and Q2 that no drop item was made.
gameserver.rates.drop = 0

# Only in the scenario gate, not for play (geo data stays on with the real client):
# gameserver.geodata.enable = false
# gameserver.character.reentry.time = 1
# gameserver.shutdown.delay = 2
