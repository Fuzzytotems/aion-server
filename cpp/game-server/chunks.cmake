# Chunk manifest of the game server port (docs/design/handlers-and-porting-plan.md §2.2, §2.4-§2.10 and amendments §8-§12).
#
# One aion_gs_chunk() call per chunk part: a chunk is the unit of ownership of one porting agent, a TARGET is the static library its files are
# compiled into. A chunk may have several parts with different targets (P4-02a, P5-05, P5-14), and several chunks may share a target (P4-07a/b,
# C1/C2). The syntax, the glob language and the checks are documented in cmake/AionChunks.cmake; tools/porting/chunks.py reads this file directly
# (owner, files, java, check, check-ownership).
#
# Owned by the integrator: nobody else edits this file (§2.2). Keep it to aion_gs_chunks_settings() and aion_gs_chunk() calls and comments, so
# chunks.py can parse it without CMake.
#
# Every .cpp/.h/.ipp/.inc below src/, handlers/ and generated/ must match exactly one chunk part, and every Java file below game-server/src and
# game-server/data/handlers must be claimed by exactly one part's JAVA globs (configure fails otherwise, listing the files). Globs are relative
# to the part's ROOT(s) (C++: src, handlers, generated) or to the Java game-server directory (JAVA). Directories hold their fwd.h (generated by
# tools/gen/skeleton.py --fwd): where a package directory is split by file globs, the part that owns "the rest" of the directory owns it.
# Every .cpp/.h/.ipp/.inc below tests/ must lie in one chunk's test directory: TESTS (default: the target name without aion_gs_, plus /<chunk>
# when several chunks share the target, e.g. tests/templates/P4-07a) or TEST_SUPPORT. A chunk's unit test executable is built only from those
# directories, and chunks.py check-ownership allows exactly them.

aion_gs_chunks_settings(
	EXTENSIONS cpp h ipp inc
	ROOTS src handlers generated
	JAVA_ROOTS "src/**/*.java" "data/handlers/**/*.java"
)

# ---------------------------------------------------------------------------------------------------------------------------------------------
# Wave 1 (§2.4, built): leaf libraries. A part with DEPENDS is a leaf: it links only its dependencies (commons, runtime) and its unit tests link
# only the part's library. Every other core part links the shared core dependencies and its tests link aion_gs_core plus empty registries.
# ---------------------------------------------------------------------------------------------------------------------------------------------

# P4-01: the 33 config classes, game-server property transformers (CronExpression lives in P4-02b's services/cron)
aion_gs_chunk(P4-01 TARGET aion_gs_configs PHASE 4
	GLOBS "aion/gameserver/configs/**"
	EXCLUDE "aion/gameserver/configs/ingameshop/**" "aion/gameserver/configs/schedule/**"
	JAVA "src/com/aionemu/gameserver/configs/**"
	JAVA_EXCLUDE "src/com/aionemu/gameserver/configs/ingameshop/**" "src/com/aionemu/gameserver/configs/schedule/**"
	DEPENDS aion_gs_runtime aion_commons_configuration
	TESTS configs)

# P4-02a (runtime lifetime lane): kernel libraries without Java counterparts, bottom-up (see the dependency comment in CMakeLists.txt). It owns
# the shared kernel test support (tests/runtime/support) and the stress harness (tests/runtime/stress, built by CMakeLists.txt); P4-02b leases
# both.
aion_gs_chunk(P4-02a TARGET aion_gs_runtime_base PHASE 4
	GLOBS "aion/gameserver/runtime/base/**"
	DEPENDS aion_commons_core
	TESTS runtime/base TEST_INCLUDES runtime TEST_SUPPORT runtime/support runtime/stress)
aion_gs_chunk(P4-02a TARGET aion_gs_runtime_sync PHASE 4
	GLOBS "aion/gameserver/runtime/sync/**"
	DEPENDS aion_gs_runtime_base
	TESTS runtime/sync TEST_INCLUDES runtime)
aion_gs_chunk(P4-02a TARGET aion_gs_runtime_lifetime PHASE 4
	GLOBS "aion/gameserver/runtime/lifetime/**"
	DEPENDS aion_gs_runtime_sync
	TESTS runtime/lifetime TEST_INCLUDES runtime)
aion_gs_chunk(P4-02a TARGET aion_gs_runtime_fields PHASE 4
	GLOBS "aion/gameserver/runtime/fields/**"
	DEPENDS aion_gs_runtime_lifetime
	TESTS runtime/fields TEST_INCLUDES runtime)
aion_gs_chunk(P4-02a TARGET aion_gs_runtime_collections PHASE 4
	GLOBS "aion/gameserver/runtime/collections/**"
	DEPENDS aion_gs_runtime_lifetime
	TESTS runtime/collections TEST_INCLUDES runtime)

# P4-02b (runtime scheduling lane): scheduler, ThreadPoolManager, cron, IDFactory, services, the handler registry. The Java class listeners and
# loaders of the scripting engine are replaced by HandlerRegistry.h and aion_gs_regscan (§1.1), so this chunk claims them.
aion_gs_chunk(P4-02b TARGET aion_gs_runtime_sched PHASE 4
	GLOBS "aion/gameserver/runtime/sched/**" "aion/gameserver/utils/ThreadPoolManager.*"
	JAVA "src/com/aionemu/gameserver/utils/ThreadPoolManager.java"
	DEPENDS aion_gs_runtime_lifetime
	TESTS runtime/sched TEST_INCLUDES runtime)
aion_gs_chunk(P4-02b TARGET aion_gs_runtime_services PHASE 4
	GLOBS "aion/gameserver/runtime/services/**" "aion/gameserver/services/cron/**" "aion/gameserver/utils/cron/**" "aion/gameserver/utils/idfactory/**"
	JAVA "src/com/aionemu/gameserver/services/cron/**" "src/com/aionemu/gameserver/utils/cron/**" "src/com/aionemu/gameserver/utils/idfactory/**"
	DEPENDS aion_gs_runtime_sched aion_gs_runtime_collections aion_gs_runtime_fields aion_commons_configuration
	TESTS runtime/services TEST_INCLUDES runtime)
aion_gs_chunk(P4-02b TARGET aion_gs_handler_registry PHASE 4
	GLOBS "aion/gameserver/handlers/**"
	JAVA "src/com/aionemu/gameserver/ai/AIHandlerClassListener.java" "src/com/aionemu/gameserver/instance/InstanceHandlerClassListener.java"
		"src/com/aionemu/gameserver/questEngine/handlers/QuestHandlerLoader.java" "src/com/aionemu/gameserver/utils/chathandlers/ChatCommandsLoader.java"
		"src/com/aionemu/gameserver/world/zone/handler/ZoneHandlerClassListener.java"
	DEPENDS aion_gs_runtime
	TESTS handler_registry)
aion_gs_chunk(P4-02b LEASE PHASE 4
	TEST_SUPPORT runtime/support runtime/stress)

