	GLOBS "aion/gameserver/geoEngine/**"
	EXCLUDE "aion/gameserver/geoEngine/math/**"
	JAVA "src/com/aionemu/gameserver/geoEngine/**"
	JAVA_EXCLUDE "src/com/aionemu/gameserver/geoEngine/math/**")

